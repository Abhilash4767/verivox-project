# Copy to .env and adjust.

# Shared secret the dashboard sends as `Authorization: Bearer <key>`.
# Must match MODEL_API_KEY configured in the Lovable app secrets.
MODEL_API_KEY=change-me-to-a-long-random-string

# Server
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:8080,https://your-app.lovable.app

# Paths (relative to the backend/ folder)
DATA_DIR=data
DATASET_DIR=data/dataset
UPLOAD_DIR=data/uploads
MODEL_DIR=models

# Feature extraction
SAMPLE_RATE=16000
N_MFCC=40
N_MELS=128
MAX_SECONDS=8.0

# Training defaults
DEFAULT_EPOCHS=25
BATCH_SIZE=16
LEARNING_RATE=0.001
VAL_SPLIT=0.2

# Set to 1 to also compute Wav2Vec2 embeddings (downloads ~360MB on first run)
ENABLE_WAV2VEC2=0
WAV2VEC2_MODEL=facebook/wav2vec2-base
